{
  "name": "solar-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config apps/explorer/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/explorer/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test packages/simulation/test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.7"
  }
}
